# 校招宝开源版环境变量模板（复制为 .env 后按需填写；默认即可直接跑）
# 站点对外域名：影响 sitemap/canonical/JSON-LD/og 链接，本地跑填 http://localhost:3600
XZB_SITE_BASE=http://localhost:3600
# 服务端口
PORT=3600
# 管理后台密钥（不填则管理接口不可用）
# ADMIN_KEY=
# JWT 密钥（不填则每次启动随机生成，登录态重启后失效）
# JWT_SECRET=
# 邮件配置（可选；不填则验证码走演示模式，接口直接返回验证码）
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# 大模型（可选；用于岗位说明书/AI 功能，不填则相关功能降级）
# HUNYUAN_API_KEY=
# HUNYUAN_ENDPOINT=https://tokenhub.tencentmaas.com/v1/chat/completions
# HUNYUAN_MODEL=hy3
# DEEPSEEK_API_KEY=
# DEEPSEEK_ENDPOINT=https://tokenhub.tencentmaas.com/v1/chat/completions
# DEEPSEEK_MODEL=deepseek-v4-flash-202605
